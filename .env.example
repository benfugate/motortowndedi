# Copy to .env and fill in. .env is gitignored.

# --- Steam ---------------------------------------------------------------------------------
# App 2223650 is a Tool that requires an account owning Motor Town; anonymous login only sees
# an empty stub. Run `docker compose run --rm motortown login` once to answer Steam Guard.
STEAM_USERNAME=
# Optional once the login above is cached. Leaving it blank is the safer default.
STEAM_PASSWORD=

# The live server build sits on a private, password-protected branch named `beta`
# ("Live Version" in Steam). Community images that target `test` are on the old branch name.
STEAM_BRANCH=beta
STEAM_BETA_PASSWORD=

# Set to true for one start to make steamcmd re-verify every file, then set it back.
VALIDATE=false

# --- Server --------------------------------------------------------------------------------
SERVER_PARAMS=Jeju_World?listen? -server -useperfthreads

# Seconds to wait for the world to save on shutdown. docker-compose.yml's stop_grace_period
# must stay above this.
SHUTDOWN_TIMEOUT=120

# --- Host ----------------------------------------------------------------------------------
CONTAINER_NAME=motortown
APPDATA=/mnt/user/appdata/motortown

GAME_PORT=7777
QUERY_PORT=27015
# Must match HostWebAPIServerPort in DedicatedServerConfig.json.
WEB_API_PORT=8060

# Unraid defaults: nobody:users.
PUID=99
PGID=100
UMASK=000
